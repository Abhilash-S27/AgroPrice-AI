# ──────────────────────────────────────────────────────────
# AgroPrice AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────

# ── AI API Keys ────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Which AI advisor to use by default: "claude" or "gemini"
DEFAULT_AI_ADVISOR=claude

# ── Data Paths ─────────────────────────────────────────────
# Absolute path to the project's data/ directory
# Windows example: D:/mca/2nd semester/GEN AI/EL Project/AgroPrice-AI/data
DATA_PATH=./data

# Path where DuckDB will persist its database file
# Leave blank to use an in-memory DuckDB instance
DUCKDB_PATH=./data/agroprice.duckdb

# ── Cache Configuration ────────────────────────────────────
# How many hours to keep cached forecast results
CACHE_TTL_HOURS=24

# Directory for file-based cache
CACHE_DIR=./data/cache

# ── Backend Server ─────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5177,http://localhost:5173,http://localhost:3000

# ── Forecasting Defaults ───────────────────────────────────
# Default number of days to forecast ahead
DEFAULT_FORECAST_DAYS=90

# Minimum data points required to run a forecast
MIN_DATA_POINTS=30

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/agroprice.log
