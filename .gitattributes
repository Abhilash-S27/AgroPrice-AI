# Normalise line endings in the repo
* text=auto

# Always LF in repo for code files
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows scripts keep CRLF
*.bat   text eol=crlf

# Binary — no line-ending conversion
*.parquet  binary
*.duckdb   binary
*.pkl      binary
*.joblib   binary
*.h5       binary
*.geojson  binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
